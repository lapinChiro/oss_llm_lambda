# Test Environment Configuration
# This file is used by vitest and can be committed to the repository
# as it contains only test values (no secrets)

# Database Configuration
DB_HOST=localhost
DB_PORT=5435
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=app_dev
DB_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# Database URL for kysely-codegen
DATABASE_URL=postgresql://postgres:password@localhost:5435/app_dev

# Application Settings
NODE_ENV=test
# テスト時はアプリのロガーを全抑止する (期待エラーのテストでも ERROR ログ/バックトレースが
# stderr に出ると、正常な期待エラーか予期せぬエラーか CI ログ上で判別しづらくなるため)。
# テスト失敗時の信号は vitest 自身の assertion / throw 出力が担う。prod の LOG_LEVEL は
# 別 env (CDK/SSM) で管理しており本変更の影響を受けない (= ハンドリング済みエラーでも
# バックトレースを出力する prod 挙動は不変)。
LOG_LEVEL=silent

# Frontend URL
FRONTEND_URL=http://localhost:5173
