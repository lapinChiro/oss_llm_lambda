{
  "name": "backend",
  "version": "0.1.0",
  "dependencies": {
    "@app/shared": "1.0.0",
    "@app/utils": "1.0.0",
    "@hono/node-server": "2.0.6",
    "@hono/zod-openapi": "1.4.0",
    "hono": "4.12.27",
    "kysely": "0.29.2",
    "pg": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.3",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/pg": "8.20.0",
    "ajv-formats": "3.0.1",
    "kysely-codegen": "0.20.0",
    "openapi-backend": "5.18.0",
    "oxlint-tsgolint": "0.23.0",
    "vite": "8.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:time": "time npm run build 2>&1 | grep real",
    "dev": "tsx watch --env-file .env src/index.ts",
    "generate-types": "kysely-codegen --dialect postgres --date-parser string --out-file src/db/generated-types.ts",
    "knip:fix": "knip --fix --allow-remove-files --no-config-hints --no-exit-code",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "lint:fix": "run-s lint:oxlint:fix lint:eslint:fix",
    "lint:oxlint": "git ls-files --cached --others --exclude-standard '*.ts' | xargs oxlint --type-aware --ignore-path .gitignore",
    "lint:oxlint:fix": "git ls-files --cached --others --exclude-standard '*.ts' | xargs oxlint --type-aware --fix --ignore-path .gitignore",
    "migrate": "tsx --env-file-if-exists .env src/db/migrate.ts",
    "migrate:down": "tsx --env-file-if-exists .env src/db/migrate.ts down",
    "quality": "npm run type-check && npm run lint && npm run test:coverage",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:time": "time npm run test 2>&1 | grep real",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "type": "module"
}
