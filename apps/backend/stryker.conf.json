{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.stryker.config.ts",
    "related": false
  },
  "coverageAnalysis": "perTest",
  "reporters": ["html", "clear-text", "progress"],
  "incremental": true,
  "ignoreStatic": true,
  "timeoutMS": 60000,
  "timeoutFactor": 2,
  "thresholds": {
    "high": 95,
    "low": 90,
    "break": 93
  },
  "mutate": ["src/errors/database-error-converter.ts", "src/services/todo.service.ts"]
}
