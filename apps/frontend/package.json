{
  "name": "frontend",
  "version": "0.1.0",
  "dependencies": {
    "@app/shared": "1.0.0",
    "vue": "3.5.39",
    "vue-router": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@storybook/addon-vitest": "10.5.5",
    "@storybook/vue3-vite": "10.4.6",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@tailwindcss/vite": "4.3.1",
    "@tsconfig/node24": "24.0.4",
    "@vitejs/plugin-vue": "6.0.7",
    "@vitest/browser": "4.1.9",
    "@vitest/browser-playwright": "4.1.9",
    "@vue/tsconfig": "0.9.1",
    "eslint-plugin-storybook": "10.4.6",
    "eslint-plugin-vue": "10.9.2",
    "happy-dom": "20.10.6",
    "jiti": "2.7.0",
    "oxlint-tsgolint": "0.23.0",
    "playwright": "1.61.1",
    "storybook": "10.4.6",
    "tailwindcss": "4.3.1",
    "vite": "8.1.0",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.5"
  },
  "private": true,
  "scripts": {
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "build-storybook": "storybook build",
    "dev": "vite",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "lint:fix": "run-s lint:oxlint:fix lint:eslint:fix",
    "lint:oxlint": "git ls-files --cached --others --exclude-standard '*.ts' '*.vue' | xargs oxlint --type-aware --ignore-path .gitignore",
    "lint:oxlint:fix": "git ls-files --cached --others --exclude-standard '*.ts' '*.vue' | xargs oxlint --type-aware --fix --ignore-path .gitignore",
    "postbuild": "tsx scripts/generate-version-json.ts",
    "preview": "vite preview",
    "quality": "npm run type-check && npm run lint && npm run test",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run --project unit",
    "test-storybook": "vitest run --project storybook",
    "test:coverage": "vitest run --project unit --coverage",
    "test:e2e": "npm run build -w @app/shared -w @app/utils && docker compose -f ../../docker/compose.yaml up -d --wait postgres && env DB_HOST=127.0.0.1 DB_PORT=5435 DB_USER=postgres DB_PASSWORD=password DB_NAME=app_dev DATABASE_URL=postgresql://postgres:password@127.0.0.1:5435/app_dev npm run migrate -w backend && playwright test",
    "test:mutation": "stryker run",
    "type-check": "vue-tsc --build"
  },
  "type": "module"
}
