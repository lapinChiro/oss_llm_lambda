{
  "name": "full-stack-web-template",
  "description": "Reusable Vue, Hono, PostgreSQL, and AWS CDK web application template",
  "version": "1.0.0",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.2",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-oxlint": "1.71.0",
    "eslint-plugin-perfectionist": "5.9.1",
    "knip": "6.33.0",
    "npm-run-all2": "9.0.2",
    "oxlint": "1.71.0",
    "syncpack": "15.3.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.0",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "keywords": [
    "aws-cdk",
    "hono",
    "postgresql",
    "template",
    "vue"
  ],
  "license": "MIT",
  "overrides": {
    "typescript": "6.0.3"
  },
  "private": true,
  "scripts": {
    "backend": "npm run -w backend",
    "build": "npm run build --workspaces --if-present",
    "build:backend": "npm run build -w backend",
    "build:frontend": "npm run build -w frontend",
    "check:deps": "npm outdated && npm outdated --workspaces",
    "clean:install": "npm run clean:modules && npm run install:all",
    "clean:modules": "rm -rf node_modules package-lock.json && rm -rf apps/*/node_modules",
    "db:backup": "docker exec webapp_postgres pg_dump -U postgres app_dev > backup-$(date +%Y%m%d-%H%M%S).sql",
    "db:clear": "docker exec -it webapp_postgres psql -U postgres -d app_dev -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;'",
    "db:generate-types": "npm run generate-types -w backend",
    "db:migrate": "npm run migrate -w backend",
    "db:migrate:down": "npm run migrate:down -w backend",
    "db:psql": "docker exec -it webapp_postgres psql -U postgres -d app_dev",
    "dev": "npm run build -w @app/shared -w @app/utils && run-p --print-label docker:compose:up dev:backend dev:frontend",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "dev:local": "npm run build -w @app/shared -w @app/utils && run-p --print-label dev:backend dev:frontend",
    "docker:backend": "docker exec -it webapp_backend sh",
    "docker:backend::down": "docker exec -it webapp_backend sh -c 'npm run migrate:down'",
    "docker:backend::generate-types": "docker exec -it webapp_backend sh -c 'npm run generate-types'",
    "docker:backend::migrate": "docker exec -it webapp_backend sh -c 'npm run migrate'",
    "docker:clean": "docker compose -f docker/compose.yaml down -v",
    "docker:compose:up": "docker compose -f docker/compose.yaml up -d",
    "docker:down": "docker compose -f docker/compose.yaml down",
    "docker:frontend": "docker exec -it webapp_frontend sh",
    "docker:logs": "docker compose -f docker/compose.yaml logs -f",
    "docker:restart": "npm run docker:down && npm run docker:up",
    "docker:stop": "docker compose -f docker/compose.yaml stop",
    "docker:up": "npm run build -w @app/shared -w @app/utils && npm run docker:compose:up",
    "frontend": "npm run -w frontend",
    "install:all": "npm install && npm install --workspaces",
    "knip": "knip --no-config-hints",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "quality": "run-s sync:deps:check type-check lint test build knip",
    "quality:full": "run-s quality test:coverage test:storybook test:mutation",
    "sync:deps": "syncpack fix && syncpack format",
    "sync:deps:check": "syncpack lint && syncpack format --check",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w frontend",
    "test:mutation": "run-s test:mutation:backend test:mutation:frontend",
    "test:mutation:backend": "npm run test:mutation -w backend",
    "test:mutation:frontend": "npm run test:mutation -w frontend",
    "test:storybook": "npm run test-storybook -w frontend",
    "test:watch": "npm run test:watch --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "workspace": "npm run --workspaces"
  },
  "type": "commonjs",
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra"
  ]
}
