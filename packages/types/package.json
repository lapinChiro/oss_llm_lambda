{
  "name": "@app/shared",
  "description": "Shared API contracts for the web application",
  "version": "1.0.0",
  "exports": {
    ".": {
      "app-source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "lint:fix": "run-s lint:oxlint:fix lint:eslint:fix",
    "lint:oxlint": "git ls-files --cached --others --exclude-standard '*.ts' | xargs oxlint --type-aware --ignore-path .gitignore",
    "lint:oxlint:fix": "git ls-files --cached --others --exclude-standard '*.ts' | xargs oxlint --type-aware --fix --ignore-path .gitignore",
    "quality": "npm run type-check && npm run lint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "type": "module",
  "types": "./src/index.ts"
}
